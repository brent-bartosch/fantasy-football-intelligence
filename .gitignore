__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Database
*.db
*.sqlite
*.sql.backup

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/*
# ...but the P4 ceiling per-cell dumps are EVIDENCE, not logs. Task 10's review
# could not re-derive the per-season numbers because every artifact behind them
# was gitignored. `--dump-cells` output is small (~70K/300 cells) and tracked.
!logs/waiver-ceiling-*-cells.json

# Data files
data/*.csv
data/*.json
data/*.xlsx
# ...but curated config (not bulk data) is tracked:
!data/backtest_name_overrides.json
!data/p_starts.json

# Live draft event logs (Task 13 — the draft-day source of truth; local only)
data/draft-logs/

# Manual league-state captures (other managers' names + roster state; ADR 2026-08-30 D3)
data/captures/

# Temporary files
tmp/
temp/
*.tmp

# Browser automation profiles (authenticated session state = secrets)
browser-profiles/
.playwright/
playwright/.auth/

# Database backups
/backups/

# Morning briefing output artifacts (repo-root reports/ only).
# Anchored: an unanchored `reports/` also swallows src/ffi/reports/, the
# Layer-4 renderer package (ARCHITECTURE §1b) — its files would be silently
# untracked and lost on a fresh clone.
/reports/