<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ffi.trends</string>
  <key>WorkingDirectory</key><string>/Users/brentbartosch/Development/fantasy_football</string>
  <!-- Tuesday trends & targets report, after the Tuesday waiver run. The fire
       time is the league clock's hard fallback (deadline("waivers") + 12h =
       Tuesday 12:00 local); the report renders gated on the usage source, so a
       BROKEN nflverse feed renders NO SIGNAL rather than a confident trend list
       computed from a failed feed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>uv run python scripts/run_trends_report.py</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>logs/launchd-trends.log</string>
  <key>StandardErrorPath</key><string>logs/launchd-trends.err</string>
</dict></plist>
